# Django Environment Variables Configuration Template
# Rename this file to .env and adjust the settings for your environment

# Security
SECRET_KEY=django-insecure-change-this-to-a-secure-random-key-in-production-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL in production, SQLite fallback in local dev)
# Example PostgreSQL URL: postgres://user:password@localhost:5432/exam_db
# For local dev without Postgres, leave DATABASE_URL commented or empty to use SQLite automatically:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/exam_system_db

# Time Zone
TIME_ZONE=UTC
